[scenario]
    id=01_rooting_out_a_mage
    name="Искоренение мага"
    objective="Убейте Мордака; гибель Арвита или окончание 18-го хода означает поражение"
    next_scenario=02_the_chase
    campaign_side=player
    carryover_percentage=40
    random_seed=363
    base_income=2
    village_income=2
    village_support=1
    village_heal=8

    [resources]
        map=maps/rooting_out_a_mage.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/knight.wml,units/spearman.wml,units/bowman.wml,units/dark_sorcerer.wml,units/walking_corpse.wml
        dialogs=dialogs/rooting_out_a_mage.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]

    on_start_dialog=rooting_intro

    [side]
        id=player
        controller=human
        gold=25
        recruit=spearman,bowman
    [/side]
    [side]
        id=enemy
        controller=ai
        passive_leader=yes
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=knight
        side=player
        is_leader=yes
        x=3
        y=6
    [/unit]
    [unit]
        id=Alwyn
        name="Алвин"
        type=spearman
        side=player
        x=2
        y=5
        upkeep=loyal
    [/unit]
    [unit]
        id=Brent
        name="Брент"
        type=spearman
        side=player
        x=3
        y=5
        upkeep=loyal
    [/unit]
    [unit]
        id=Efran
        name="Эфран"
        type=bowman
        side=player
        x=4
        y=6
        upkeep=loyal
    [/unit]

    [unit]
        id=Mordak
        name="Мордак"
        type=dark_sorcerer
        side=enemy
        is_leader=yes
        x=10
        y=4
    [/unit]
    [unit]
        id=thrall_one
        type=walking_corpse
        side=enemy
        x=8
        y=3
    [/unit]
    [unit]
        id=thrall_two
        type=walking_corpse
        side=enemy
        x=8
        y=5
    [/unit]

    [village]
        x=2
        y=4
        side=player
    [/village]
    [village]
        x=5
        y=2
    [/village]
    [village]
        x=7
        y=4
    [/village]
    [village]
        x=5
        y=7
        side=player
    [/village]
    [village]
        x=10
        y=6
        side=enemy
    [/village]

    [turn_event]
        id=baran_ready
        turn=6
        dialog=rooting_turn_6
    [/turn_event]
    [turn_event]
        id=baran_missing
        turn=10
        dialog=rooting_turn_10
    [/turn_event]

    [objective]
        result=victory
        when=unit_defeated
        unit=Mordak
        killer_variable=who_slew_mordak
        dialog=rooting_victory
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=rooting_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=18
        dialog=rooting_time_over
    [/objective]
[/scenario]
