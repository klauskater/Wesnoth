[scenario]
    id=first_battle
    name="Первая битва"
    objective="Победите всех противников"
    random_seed=1

    [resources]
        map=maps/first_battle.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml
        unit_types=units/elvish_archer.wml,units/elvish_marksman.wml,units/elvish_ranger.wml,units/orcish_grunt.wml,units/orcish_warrior.wml
        dialogs=dialogs/first_battle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]

    on_start_dialog=first_battle_intro

    [side]
        id=player
        controller=human
    [/side]

    [side]
        id=enemy
        controller=ai
    [/side]

    [unit]
        id=alice
        type=elvish_archer
        side=player
        x=2
        y=2
    [/unit]

    [unit]
        id=elara
        type=elvish_archer
        side=player
        x=2
        y=4
    [/unit]

    [unit]
        id=bob
        type=orcish_grunt
        side=enemy
        x=3
        y=2
    [/unit]

    [unit]
        id=boris
        type=orcish_grunt
        side=enemy
        x=3
        y=4
    [/unit]

    [objective]
        result=victory
        when=enemies_defeated
        side=player
        dialog=first_battle_victory
    [/objective]

    [objective]
        result=defeat
        when=side_defeated
        side=player
        dialog=first_battle_defeat
    [/objective]
[/scenario]
