[scenario]
    id=abilities_test
    name="Проверка способностей"
    random_seed=1
    [resources]
        map=maps/first_battle.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml
        unit_types=units/elvish_archer.wml,units/elvish_marksman.wml,units/elvish_ranger.wml,units/elvish_fighter.wml,units/elvish_hero.wml,units/orcish_grunt.wml,units/orcish_raider.wml,units/orcish_warrior.wml
        dialogs=dialogs/first_battle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=first_battle_intro
    [side]
        id=player
        controller=human
    [/side]
    [side]
        id=enemy
        controller=ai
    [/side]

    [unit]
        id=leader
        type=elvish_hero
        side=player
        x=2
        y=2
    [/unit]
    [unit]
        id=soldier
        type=elvish_fighter
        side=player
        x=3
        y=2
    [/unit]
    [unit]
        id=steadfast_target
        type=orcish_warrior
        side=enemy
        x=4
        y=2
    [/unit]
    [unit]
        id=healer
        type=elvish_fighter
        side=player
        x=2
        y=5
    [/unit]
    [unit]
        id=patient
        type=elvish_archer
        side=player
        x=3
        y=5
        initial_hitpoints=20
    [/unit]
    [unit]
        id=scout
        type=orcish_raider
        side=player
        x=6
        y=5
        initial_hitpoints=10
        poisoned=yes
    [/unit]
    [unit]
        id=guard
        type=orcish_grunt
        side=enemy
        x=7
        y=4
    [/unit]
[/scenario]
