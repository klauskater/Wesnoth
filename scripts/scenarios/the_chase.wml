[scenario]
    id=02_the_chase
    name="Погоня"
    objective="Пробейтесь через Серый лес и настигните похитителей"
    next_scenario=03_guarded_castle
    campaign_side=player
    carryover_percentage=40
    recall_cost=20
    random_seed=364
    base_income=2
    village_income=2
    village_support=1
    village_heal=8
    vision_radius=8

    on_start_dialog=chase_intro

    [side]
        id=player
        flag_style=loyalist
        controller=human
        team_name=good
        shroud=yes
        gold=180
        income=10
        recruit=Horseman,Bowman,Spearman,Footpad
    [/side]
    [side]
        id=elves
        flag_style=wood-elvish
        controller=ai
        team_name=elves
        gold=25
        income=-8
        recruit=Elvish Scout
    [/side]
    [side]
        id=kidnappers
        flag_style=undead
        controller=ai
        team_name=elves
        passive_leader=yes
        defeat_condition=no_leader_left
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=Knight
        side=player
        is_leader=yes
        x=10
        y=51
    [/unit]
    [unit]
        id=Nil-Galion
        name="Нил-Галион"
        type=Elvish Rider
        side=elves
        is_leader=yes
        x=6
        y=24
    [/unit]
    [unit]
        id=elf_scout_1
        type=Elvish Scout
        side=elves
        x=15
        y=20
    [/unit]
    [unit]
        id=elf_fighter
        type=Elvish Fighter
        side=elves
        x=5
        y=13
    [/unit]
    [unit]
        id=elf_scout_2
        type=Elvish Scout
        side=elves
        x=4
        y=36
    [/unit]
    [unit]
        id=elf_scout_3
        type=Elvish Scout
        side=elves
        x=7
        y=46
    [/unit]
    [unit]
        id=elf_scout_4
        type=Elvish Scout
        side=elves
        x=15
        y=35
    [/unit]
    [unit]
        id=Muff_Toras
        name="Мафф Торас"
        type=Dark Adept
        side=kidnappers
        is_leader=yes
        x=9
        y=5
    [/unit]
    [unit]
        id=summoned_skeleton_1
        type=Skeleton
        side=kidnappers
        x=9
        y=3
        reserve_group=muff_summons
    [/unit]
    [unit]
        id=summoned_skeleton_2
        type=Skeleton
        side=kidnappers
        x=10
        y=5
        reserve_group=muff_summons
    [/unit]

    [sight_event]
        id=kidnappers_found
        viewer_side=player
        target=Muff_Toras
        spawn_group=muff_summons
        set_team_side=kidnappers
        set_team_name=evil
        ally_side=elves
        ally_team_name=good
        dialog=kidnappers_found
    [/sight_event]
    [turn_event]
        id=keep_chasing
        turn=12
        dialog=chase_turn_12
    [/turn_event]
    [objective]
        result=victory
        when=unit_defeated
        unit=Muff_Toras
        dialog=chase_victory
        [campaign_variable]
            name=first_password
            options=Sithrak,Eleben,Jarlom,Hamik
        [/campaign_variable]
        [campaign_variable]
            name=second_password
            options=Akranbral,Drakanal,Xaskanat,Katklagad
        [/campaign_variable]
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=chase_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=28
        dialog=chase_time_over
    [/objective]
[/scenario]
