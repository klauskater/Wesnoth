[scenario]
    id=02_the_chase
    name="Погоня"
    objective="Пробейтесь через лес и настигните похитителей"
    next_scenario=03_guarded_castle
    campaign_side=player
    carryover_percentage=40
    recall_cost=20
    random_seed=364
    base_income=2
    village_income=2
    village_support=1
    village_heal=8

    [resources]
        map=maps/the_chase.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/knight.wml,units/spearman.wml,units/bowman.wml,units/dark_sorcerer.wml,units/walking_corpse.wml,units/elvish_fighter.wml,units/elvish_archer.wml,units/elvish_hero.wml
        dialogs=dialogs/the_chase.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=chase_intro

    [side]
        id=player
        controller=human
        gold=120
        recruit=spearman,bowman
    [/side]
    [side]
        id=enemy
        controller=ai
        passive_leader=yes
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=knight
        side=player
        is_leader=yes
        x=2
        y=10
    [/unit]
    [unit]
        id=Nil-Galion
        name="Нил-Галион"
        type=elvish_hero
        side=enemy
        is_leader=yes
        x=10
        y=1
    [/unit]
    [unit]
        id=elf_scout_one
        type=elvish_archer
        side=enemy
        x=5
        y=7
    [/unit]
    [unit]
        id=elf_scout_two
        type=elvish_fighter
        side=enemy
        x=8
        y=5
    [/unit]
    [unit]
        id=Muff_Toras
        name="Мафф Торас"
        type=dark_sorcerer
        side=enemy
        x=9
        y=2
        reserve_group=kidnappers
    [/unit]
    [unit]
        id=kidnapper_guard_one
        type=walking_corpse
        side=enemy
        x=8
        y=2
        reserve_group=kidnappers
    [/unit]
    [unit]
        id=kidnapper_guard_two
        type=walking_corpse
        side=enemy
        x=10
        y=2
        reserve_group=kidnappers
    [/unit]

    [phase]
        id=search_woods
        label="Достигните северной опушки"
        when=unit_reaches
        side=player
        x=6
        y=2
        next=catch_kidnappers
    [/phase]
    [phase]
        id=catch_kidnappers
        label="Победите Маффа Тораса"
        spawn_group=kidnappers
        dialog=kidnappers_found
    [/phase]

    [turn_event]
        id=keep_chasing
        turn=12
        dialog=chase_turn_12
    [/turn_event]
    [objective]
        result=victory
        when=unit_defeated
        unit=Muff_Toras
        dialog=chase_victory
        [campaign_variable]
            name=first_password
            value=Sithrak
        [/campaign_variable]
        [campaign_variable]
            name=second_password
            value=Akranbral
        [/campaign_variable]
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=chase_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=24
        dialog=chase_time_over
    [/objective]
[/scenario]
