[scenario]
    id=specials_test
    name="Проверка особенностей атак"
    random_seed=1
    [resources]
        map=maps/first_battle.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml
        unit_types=units/elvish_archer.wml,units/elvish_marksman.wml,units/elvish_ranger.wml,units/elvish_fighter.wml,units/elvish_hero.wml,units/orcish_grunt.wml,units/orcish_warrior.wml
        dialogs=dialogs/first_battle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=first_battle_intro
    [side]
        id=player
        controller=human
    [/side]
    [side]
        id=enemy
        controller=ai
    [/side]

    [unit]
        id=marksman
        type=elvish_marksman
        side=player
        x=2
        y=2
    [/unit]
    [unit]
        id=magic_target
        type=orcish_grunt
        side=enemy
        x=3
        y=2
    [/unit]
    [unit]
        id=fighter
        type=elvish_fighter
        side=player
        x=2
        y=4
    [/unit]
    [unit]
        id=slow_target
        type=orcish_grunt
        side=enemy
        x=3
        y=4
    [/unit]
    [unit]
        id=grunt
        type=orcish_grunt
        side=player
        x=5
        y=1
    [/unit]
    [unit]
        id=hero
        type=elvish_hero
        side=enemy
        x=6
        y=1
        initial_hitpoints=30
    [/unit]
    [unit]
        id=warrior
        type=orcish_warrior
        side=player
        x=5
        y=6
    [/unit]
    [unit]
        id=berserk_target
        type=elvish_hero
        side=enemy
        x=6
        y=6
    [/unit]
[/scenario]
