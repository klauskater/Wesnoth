[scenario]
    id=04_return_to_the_village
    name="Возвращение в деревню"
    objective="Узнайте, что происходит в Магре, и освободите деревню"
    campaign_side=player
    carryover_percentage=0
    recall_cost=20
    random_seed=366
    base_income=2
    village_income=2
    village_support=1
    village_heal=8
    vision_radius=8

    [resources]
        map=maps/return_to_the_village.wml
        map_objects=map_objects/road.wml,map_objects/dirt.wml,map_objects/grassland.wml,map_objects/decorations.wml,map_objects/bridges.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/core-1.18.8.wml
        dialogs=dialogs/return_to_the_village.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=village_intro

    [side]
        id=player
        flag_style=loyalist
        controller=human
        team_name=good
        fog=yes
        gold=140
        recruit=Horseman,Bowman,Spearman,Footpad
    [/side]
    [side]
        id=enemy
        flag_style=ragged
        controller=ai
        team_name=evil
        defeat_condition=no_leader_left
        gold=150
        income=10
        recruit=Goblin Spearman,Wolf Rider,Orcish Archer,Orcish Grunt,Troll Whelp
    [/side]
    [side]
        id=allies
        flag_style=loyalist
        controller=ai
        team_name=good
        gold=60
        income=4
        recruit=Bowman,Spearman
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=Knight
        side=player
        is_leader=yes
        x=4
        y=28
    [/unit]
    [unit]
        id=Baran
        name="Баран"
        type=Red Mage
        side=player
        x=5
        y=28
        upkeep=loyal
    [/unit]
    [unit]
        id=Tairach
        name="Тарайх"
        type=Orcish Warlord
        side=enemy
        is_leader=yes
        x=25
        y=14
    [/unit]
    [unit]
        id=Reeve_Hoban
        name="Староста Хобан"
        type=Longbowman
        side=allies
        is_leader=yes
        x=13
        y=3
    [/unit]

    [sight_event]
        id=village_defenders_found
        viewer_side=player
        target=Reeve_Hoban
        dialog=village_besieged
    [/sight_event]
    [attack_event]
        id=baran_attacks_tairach
        group=baran_tairach
        attacker=Baran
        defender=Tairach
        dialog=baran_faces_tairach
    [/attack_event]
    [attack_event]
        id=tairach_attacks_baran
        group=baran_tairach
        attacker=Tairach
        defender=Baran
        dialog=baran_faces_tairach
    [/attack_event]
    [achievement]
        id=baran_returns
        when=unit_defeated
        unit=Tairach
        killer=Baran
    [/achievement]

    [objective]
        result=victory
        when=enemies_defeated
        side=player
        dialog=village_victory
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=village_defeat
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Baran
        dialog=village_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=26
        dialog=village_defeat
    [/objective]
[/scenario]
