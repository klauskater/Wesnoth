[scenario]
    id=04_return_to_the_village
    name="Возвращение в деревню"
    objective="Найдите старосту Хобана"
    campaign_side=player
    carryover_percentage=0
    recall_cost=20
    random_seed=366
    base_income=2
    village_income=2
    village_support=1
    village_heal=8
    vision_radius=2

    [resources]
        map=maps/return_to_the_village.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/knight.wml,units/spearman.wml,units/bowman.wml,units/red_mage.wml,units/orcish_grunt.wml,units/orcish_warrior.wml
        dialogs=dialogs/return_to_the_village.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=village_intro

    [side]
        id=player
        controller=human
        team_name=good
        fog=yes
        shroud=yes
        gold=120
        recruit=spearman,bowman
    [/side]
    [side]
        id=enemy
        controller=ai
        team_name=evil
        defeat_condition=no_leader_left
        gold=100
        recruit=orcish_grunt
    [/side]
    [side]
        id=allies
        controller=ai
        team_name=good
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=knight
        side=player
        is_leader=yes
        x=3
        y=9
    [/unit]
    [unit]
        id=Baran
        name="Баран"
        type=red_mage
        side=player
        x=4
        y=9
        upkeep=loyal
    [/unit]
    [unit]
        id=Reeve_Hoban
        name="Староста Хобан"
        type=bowman
        side=allies
        x=9
        y=3
        upkeep=loyal
    [/unit]
    [unit]
        id=village_guard
        name="Защитник Магре"
        type=spearman
        side=allies
        x=8
        y=4
    [/unit]
    [unit]
        id=Tairach
        name="Тарайх"
        type=orcish_warrior
        side=enemy
        is_leader=yes
        x=12
        y=3
    [/unit]
    [unit]
        id=orc_raider_one
        type=orcish_grunt
        side=enemy
        x=10
        y=5
    [/unit]
    [unit]
        id=orc_raider_two
        type=orcish_grunt
        side=enemy
        x=12
        y=6
    [/unit]

    [phase]
        id=find_hoban
        label="Доберитесь до старосты Хобана"
        when=unit_reaches
        unit=Arvith
        x=9
        y=4
        next=defeat_tairach
    [/phase]

    [attack_event]
        id=baran_faces_tairach
        attacker=Baran
        defender=Tairach
        dialog=baran_faces_tairach
    [/attack_event]
    [achievement]
        id=baran_returns
        when=unit_defeated
        unit=Tairach
        killer=Baran
    [/achievement]
    [phase]
        id=defeat_tairach
        label="Убейте Тарайха и освободите Магре"
        dialog=village_besieged
        when=unit_defeated
        unit=Tairach
    [/phase]

    [objective]
        result=victory
        when=enemies_defeated
        side=player
        dialog=village_victory
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=village_defeat
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Baran
        dialog=village_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=24
        dialog=village_defeat
    [/objective]
[/scenario]
