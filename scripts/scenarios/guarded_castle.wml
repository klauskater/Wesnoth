[scenario]
    id=03_guarded_castle
    name="Охраняемый замок"
    objective="Проникните в замок и спасите Барана"
    next_scenario=04_return_to_the_village
    campaign_side=player
    carryover_percentage=40
    recall_cost=20
    random_seed=365
    base_income=2
    village_income=2
    village_support=1
    village_heal=8

    [resources]
        map=maps/guarded_castle.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/knight.wml,units/spearman.wml,units/bowman.wml,units/red_mage.wml,units/dark_sorcerer.wml,units/walking_corpse.wml,units/orcish_grunt.wml,units/orcish_warrior.wml
        dialogs=dialogs/guarded_castle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=castle_intro

    [side]
        id=player
        controller=human
        gold=120
        recruit=spearman,bowman
    [/side]
    [side]
        id=enemy
        controller=ai
        passive_leader=yes
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=knight
        side=player
        is_leader=yes
        x=4
        y=9
    [/unit]
    [unit]
        id=Guard_leader
        name="Страж"
        type=orcish_warrior
        side=enemy
        x=4
        y=6
        event_group=first_gate
    [/unit]
    [unit]
        id=castle_guard
        name="Страж замка"
        type=orcish_grunt
        side=enemy
        x=8
        y=6
        event_group=first_gate
    [/unit]
    [unit]
        id=Rotharik
        name="Ротарик"
        type=dark_sorcerer
        side=enemy
        is_leader=yes
        x=10
        y=3
    [/unit]
    [unit]
        id=undead_guard_one
        type=walking_corpse
        side=enemy
        x=8
        y=3
    [/unit]
    [unit]
        id=undead_guard_two
        type=walking_corpse
        side=enemy
        x=10
        y=4
    [/unit]
    [unit]
        id=Baran
        name="Баран"
        type=red_mage
        side=player
        x=3
        y=2
        reserve_group=prisoner
        upkeep=loyal
    [/unit]
    [unit]
        id=relief_leader
        name="Сменный караул"
        type=orcish_warrior
        side=enemy
        x=3
        y=8
        reserve_group=second_guard
        event_group=second_gate
    [/unit]
    [unit]
        id=relief_guard
        type=orcish_grunt
        side=enemy
        x=4
        y=8
        reserve_group=second_guard
        event_group=second_gate
    [/unit]

    [phase]
        id=approach
        label="Доберитесь до входа в замок"
        when=unit_reaches
        side=player
        x=6
        y=6
        choice=first_password
    [/phase]

    [choice]
        id=first_password
        dialog=first_password_prompt
        correct_dialog=castle_entered
        wrong_dialog=first_password_wrong
        expected_variable=campaign:first_password
        fallback=Sithrak
        remove_group=first_gate
        next=defeat_rotharik
        [option]
            id=Sithrak
        [/option]
        [option]
            id=Eleben
        [/option]
        [option]
            id=Jarlom
        [/option]
        [option]
            id=Hamik
        [/option]
    [/choice]
    [choice]
        id=second_password
        dialog=second_password_prompt
        correct_dialog=second_password_correct
        wrong_dialog=second_password_wrong
        expected_variable=campaign:second_password
        fallback=Akranbral
        remove_group=second_gate
        [option]
            id=Akranbral
        [/option]
        [option]
            id=Drakanal
        [/option]
        [option]
            id=Xaskanat
        [/option]
        [option]
            id=Katklagad
        [/option]
    [/choice]

    [turn_event]
        id=guard_shift
        turn=3
        spawn_group=second_guard
        choice=second_password
    [/turn_event]

    [location_event]
        id=treasury
        side=player
        x=5
        y=5
        gold=50
        achievement=treasure
        dialog=treasury_found
    [/location_event]
    [location_event]
        id=evil_altar
        side=player
        x=4
        y=5
        damage=8
        status=poisoned
        dialog=altar_triggered
    [/location_event]
    [phase]
        id=defeat_rotharik
        label="Победите Ротарика и заберите ключ"
        when=unit_defeated
        unit=Rotharik
        next=free_baran
    [/phase]
    [phase]
        id=free_baran
        label="Приведите Арвита к камере Барана"
        dialog=baran_found
        spawn_group=prisoner
        when=unit_reaches
        unit=Arvith
        x=4
        y=2
        result=victory
        finish_dialog=castle_victory
    [/phase]

    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=castle_defeat
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Baran
        dialog=castle_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=24
        dialog=castle_defeat
    [/objective]
[/scenario]
