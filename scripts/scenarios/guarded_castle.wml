[scenario]
    id=03_guarded_castle
    name="Охраняемый замок"
    objective="Проникните в замок, убейте Ротарика и освободите Барана"
    next_scenario=04_return_to_the_village
    campaign_side=player
    carryover_percentage=40
    recall_cost=20
    random_seed=365
    base_income=2
    village_income=2
    village_support=1
    village_heal=8
    vision_radius=8

    [resources]
        map=maps/guarded_castle.wml
        map_objects=map_objects/road.wml,map_objects/dirt.wml,map_objects/grassland.wml,map_objects/decorations.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml,map_objects/castle.wml,map_objects/keep.wml,map_objects/village.wml
        unit_types=units/core-1.18.8.wml
        dialogs=dialogs/guarded_castle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=castle_intro

    [side]
        id=player
        controller=human
        team_name=good
        shroud=yes
        gold=170
        recruit=Horseman,Bowman,Spearman,Footpad
    [/side]
    [side]
        id=undead
        controller=ai
        team_name=evil
        gold=30
        income=-2
        recruit=Skeleton,Skeleton Archer,Vampire Bat,Dark Adept,Ghoul,Walking Corpse
    [/side]
    [side]
        id=orcs
        controller=ai
        team_name=evil
        defeat_condition=never
        gold=0
    [/side]

    [unit]
        id=Arvith
        name="Арвит"
        type=Knight
        side=player
        is_leader=yes
        x=35
        y=31
    [/unit]
    [unit]
        id=Rotharik
        name="Ротарик"
        type=Dark Sorcerer
        side=undead
        is_leader=yes
        x=20
        y=6
    [/unit]
    [unit]
        id=Guard_leader
        name="Страж"
        type=Assassin
        side=undead
        x=28
        y=26
        event_group=first_gate
    [/unit]
    [unit]
        id=gate_guard
        name="Страж"
        type=Bandit
        side=undead
        x=30
        y=25
        event_group=first_gate
    [/unit]
    [unit]
        id=Knago-Brek
        name="Кнаго-Брек"
        type=Orcish Warrior
        side=orcs
        x=19
        y=17
    [/unit]
    [unit]
        id=orc_guard_1
        type=Orcish Grunt
        side=orcs
        x=18
        y=16
    [/unit]
    [unit]
        id=orc_guard_2
        type=Orcish Grunt
        side=orcs
        x=20
        y=16
    [/unit]
    [unit]
        id=Guard2_leader
        name="Страж"
        type=Rogue
        side=undead
        x=16
        y=24
        reserve_group=second_guard
        event_group=second_gate
    [/unit]
    [unit]
        id=second_guard_thug
        type=Thug
        side=undead
        x=17
        y=24
        reserve_group=second_guard
        event_group=second_gate
    [/unit]
    [unit]
        id=second_guard_bandit
        type=Bandit
        side=undead
        x=16
        y=23
        reserve_group=second_guard
        event_group=second_gate
    [/unit]
    [unit]
        id=Baran
        name="Баран"
        type=Red Mage
        side=player
        x=5
        y=5
        reserve_group=prisoner
        upkeep=loyal
    [/unit]

    [phase]
        id=approach
        label="Назовите первый пароль внешней страже"
        when=unit_reaches
        unit=Arvith
        x=33
        y=29
        choice=first_password
    [/phase]
    [choice]
        id=first_password
        dialog=first_password_prompt
        correct_dialog=castle_entered
        wrong_dialog=first_password_wrong
        expected_variable=campaign:first_password
        fallback=Sithrak
        remove_group=first_gate
        next=defeat_rotharik
        [option]
            id=Sithrak
        [/option]
        [option]
            id=Eleben
        [/option]
        [option]
            id=Jarlom
        [/option]
        [option]
            id=Hamik
        [/option]
    [/choice]
    [choice]
        id=second_password
        dialog=second_password_prompt
        correct_dialog=second_password_correct
        wrong_dialog=second_password_wrong
        expected_variable=campaign:second_password
        fallback=Akranbral
        remove_group=second_gate
        [option]
            id=Akranbral
        [/option]
        [option]
            id=Drakanal
        [/option]
        [option]
            id=Xaskanat
        [/option]
        [option]
            id=Katklagad
        [/option]
    [/choice]
    [turn_event]
        id=second_guard_arrives
        turn=6
        spawn_group=second_guard
        choice=second_password
    [/turn_event]
    [location_event]
        id=treasury
        side=player
        x=34
        y=4
        gold=100
        achievement=treasure
        dialog=treasury_found
    [/location_event]
    [phase]
        id=defeat_rotharik
        label="Убейте Ротарика и заберите ключ от темницы"
        when=unit_defeated
        unit=Rotharik
        next=free_baran
    [/phase]
    [phase]
        id=free_baran
        label="Приведите Арвита к камере Барана"
        dialog=baran_found
        spawn_group=prisoner
        when=unit_reaches
        unit=Arvith
        x=6
        y=5
        result=victory
        finish_dialog=castle_victory
    [/phase]

    [objective]
        result=defeat
        when=unit_defeated
        unit=Arvith
        dialog=castle_defeat
    [/objective]
    [objective]
        result=defeat
        when=unit_defeated
        unit=Baran
        dialog=castle_defeat
    [/objective]
    [objective]
        result=defeat
        when=turn_limit
        turn=30
        dialog=castle_defeat
    [/objective]
[/scenario]
