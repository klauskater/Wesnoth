[scenario]
    id=states_test
    name="Проверка состояний"
    random_seed=1
    [resources]
        map=maps/first_battle.wml
        map_objects=map_objects/grassland.wml,map_objects/forest.wml,map_objects/hills.wml,map_objects/water.wml
        unit_types=units/cockatrice.wml,units/elvish_archer.wml,units/elvish_marksman.wml,units/elvish_ranger.wml,units/elvish_fighter.wml,units/orcish_grunt.wml
        dialogs=dialogs/first_battle.wml
        rules=rules/simple_ai.lua,rules/basic_combat.lua
    [/resources]
    on_start_dialog=first_battle_intro
    [side]
        id=player
        controller=human
    [/side]
    [side]
        id=enemy
        controller=ai
    [/side]

    [unit]
        id=cockatrice
        type=cockatrice
        side=player
        x=1
        y=1
    [/unit]
    [unit]
        id=gaze_target
        type=orcish_grunt
        side=enemy
        x=2
        y=1
    [/unit]
    [unit]
        id=stun_target
        type=orcish_grunt
        side=enemy
        x=1
        y=2
    [/unit]
    [unit]
        id=statue
        type=orcish_grunt
        side=player
        x=1
        y=6
        petrified=yes
    [/unit]
    [unit]
        id=healer
        type=elvish_fighter
        side=player
        x=7
        y=6
    [/unit]
    [unit]
        id=unhealable
        type=elvish_archer
        side=player
        x=8
        y=6
        initial_hitpoints=10
        unhealable=yes
    [/unit]
[/scenario]
