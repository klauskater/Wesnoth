                halo="misc/blank-hex.png:80,halo/mage-preparation-halo[1~7].png"
                halo_y="-54:80,-54~-45,-45~-27,-27~0"
                offset="0.001:80,-0.5~-0.25,-0.25~0.25,0.25~1.0"
            [/magic_missile_trail_2_frame]
            [magic_missile_trail_3_frame]
                duration="350"
                halo="misc/blank-hex.png:120,halo/mage-preparation-halo[1~7].png"
                halo_y="-54:120,-54~-45,-45~-27,-27~0"
                offset="0.001:120,-0.5~-0.25,-0.25~0.25,0.25~1.0"
            [/magic_missile_trail_3_frame]
            [magic_missile_flare_frame]
                duration="600"
                halo="halo/mage-preparation-halo[1~7].png"
                halo_x="14"
                halo_y="-23"
                offset="0"
            [/magic_missile_flare_frame]
            [frame]
                image="units/human-magi/silver-mage+female-attack-magic[1,2,1].png:[100,700,200]"
            [/frame]
        [/attack_anim]
        [attack_anim]
            [filter_attack]
                name="staff"
            [/filter_attack]
            [frame]
                image="units/human-magi/silver-mage+female.png:50"
            [/frame]
            [frame]
                image="units/human-magi/silver-mage+female-attack-staff[1~2].png:[100,200]"
            [/frame]
            [frame]
                image="units/human-magi/silver-mage+female-attack-magic1.png:75"
            [/frame]
            [frame]
                image="units/human-magi/silver-mage+female.png:75"
            [/frame]
        [/attack_anim]
        [animation]
            apply_to="pre_teleport"
            [frame]
                image="units/human-magi/silver-mage+female-teleport-[1~8].png:[100*7,200]"
            [/frame]
            [frame]
            [/frame]
        [/animation]
        [animation]
            apply_to="post_teleport"
            [frame]
            [/frame]
            [frame]
                image="units/human-magi/silver-mage+female-teleport-[8~1].png:[100*7,200]"
            [/frame]
        [/animation]
    [/female]
[/unit_type]

