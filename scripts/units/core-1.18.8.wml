    profile="portraits/undead/walking-corpse.webp"
    max_hitpoints="18"
    max_moves="4"
    max_experience="24"
    level="0"
    alignment="chaotic"
    advances_to="Soulless"
    cost="8"
    usage="fighter"
    movement_type="smallfoot"
    [movement_costs]
        shallow_water="3"
        reef="2"
        swamp_water="3"
        flat="1"
        sand="2"
        forest="2"
        hills="2"
        mountains="3"
