    [/movement_costs]
    [defense]
        deep_water="50"
        shallow_water="50"
        reef="50"
        swamp_water="50"
        flat="50"
        sand="50"
        forest="50"
        hills="50"
        mountains="50"
        village="50"
        castle="50"
        frozen="50"
        unwalkable="50"
        cave="50"
        fungus="50"
        grassland="50"
        water="50"
        keep="50"
    [/defense]
    [resistance]
        blade="50"
        pierce="50"
        impact="50"
        fire="10"
        cold="70"
        arcane="-10"
    [/resistance]
    [ability]
        id="nightstalk"
        name="nightstalk"
        female_name="nightstalk"
        description=<<
The unit becomes invisible during night.

Enemy units cannot see this unit at night, except if they have units next to it. Any enemy unit that first discovers this unit immediately loses all its remaining movement.
>>
        special_note="This unit is able to hide at night, leaving no trace of its presence."
        affect_self="yes"
        source_id="nightstalk"
        kind="hides"
        [filter]
            [filter_location]
                time_of_day="chaotic"
            [/filter_location]
        [/filter]
    [/ability]
    [ability]
        id="skirmisher"
        name="skirmisher"
        female_name="female^skirmisher"
        description="This unit is skilled in moving past enemies quickly, and ignores all enemy Zones of Control."
        special_note="This unit’s skill at skirmishing allows it to ignore enemies’ zones of control and thus move unhindered around them."
        affect_self="yes"
        source_id="skirmisher"
        kind="skirmisher"
    [/ability]
    [attack]
        id="claws"
        name="claws"
        range="melee"
        damage_type="blade"
        damage="10"
        strikes="3"
        [special]
            id="backstab"
            name="backstab"
            description="When used offensively, this attack deals double damage if there is an enemy of the target on the opposite side of the target, and that unit is not incapacitated (turned to stone or otherwise paralyzed)."
            special_note="If there is an enemy of the target on the opposite side of the target while attacking it, this unit may backstab, inflicting double damage by creeping around behind that enemy."
            multiply="2"
            active_on="offense"
            source_id="backstab"
            kind="damage"
            [filter_opponent]
                formula=<<

                enemy_of(self, flanker) and not flanker.petrified
            where
                flanker = unit_at(direction_from(loc, other.facing))
            
>>
            [/filter_opponent]
        [/special]
    [/attack]
    [advancement]
        strict_amla="yes"
        max_times="100"
        id="amla_default"
        description="Max HP bonus +3, Max XP +20%"
        image="icons/amla-default.png"
        [effect]
            apply_to="hitpoints"
            increase_total="3"
            heal_full="yes"
        [/effect]
        [effect]
            apply_to="max_experience"
            increase="20%"
        [/effect]
        [effect]
            apply_to="status"
            remove="poisoned"
        [/effect]
        [effect]
            apply_to="status"
            remove="slowed"
        [/effect]
    [/advancement]
[/unit_type]

