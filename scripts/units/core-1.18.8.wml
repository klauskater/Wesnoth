        inherit="yes"
        hide_help="yes"
        small_profile="portraits/monsters/scuttler.webp~FL()"
        profile="portraits/monsters/scuttler.webp~RIGHT()"
        image="units/monsters/scorpion/sand-scuttler.png"
        undead_variation="sand_scorpion"
        description="Making their homes in sandy dunes, these critters are an odd mix of mundane creature and elemental beast. Though usually timid, Sand Scuttlers sometimes attack unwary travelers, especially when startled."
        hitpoints="40"
        [standing_anim]
            start_time="0"
            direction="s,sw,se"
            [frame]
                image="units/monsters/scorpion/sand-scuttler.png:150"
            [/frame]
        [/standing_anim]
        [standing_anim]
            start_time="0"
            direction="n,nw,ne"
            [frame]
                image="units/monsters/scorpion/sand-scuttler-ne.png:150"
            [/frame]
        [/standing_anim]
        [resistance]
            blade="90"
            pierce="90"
            impact="30"
            fire="200"
            cold="120"
            arcane="150"
        [/resistance]
        [defend]
            start_time="-126"
            [if]
                direction="s,se,sw"
                [frame]
                    image="units/monsters/scorpion/sand-scuttler-defend1.png:1,units/monsters/scorpion/sand-scuttler-defend2.png:250,units/monsters/scorpion/sand-scuttler-defend1.png:1"
                [/frame]
            [/if]
            [else]
                direction="n,ne,nw"
                [frame]
                    image="units/monsters/scorpion/sand-scuttler-ne-defend1.png:1,units/monsters/scorpion/sand-scuttler-ne-defend2.png:250,units/monsters/scorpion/sand-scuttler-ne-defend1.png:1"
                [/frame]
            [/else]
            [if]
                hit_sound_start_time="-25"
                hits="hit"
                [hit_sound_frame]
                    sound="hiss.wav"
                [/hit_sound_frame]
            [/if]
        [/defend]
        [attack_anim]
            direction="s,sw,se"
            start_time="-240"
            offset="0.0~-0.1:200,-0.1~0.7:160,0.7~0.0:240"
            attack_sound_start_time="-150"
            [filter_attack]
                name="pincers"
            [/filter_attack]
            [frame]
                image="units/monsters/scorpion/sand-scuttler-pincer-[1~6].png:[100,100,80*2,120,120]"
            [/frame]
            [frame]
                image="units/monsters/scorpion/sand-scuttler.png:1"
            [/frame]
            [if]
                hits="yes"
                [attack_sound_frame]
                    sound="pincers.ogg"
                [/attack_sound_frame]
            [/if]
            [else]
                hits="no"
                [attack_sound_frame]
                    sound="miss-[1~3].ogg"
                [/attack_sound_frame]
            [/else]
        [/attack_anim]
        [attack_anim]
            direction="n,nw,ne"
            start_time="-240"
            offset="0.0~-0.2:200,-0.2~0.6:160,0.6~0.0:240"
            attack_sound_start_time="-150"
            [filter_attack]
                name="pincers"
            [/filter_attack]
            [frame]
                image="units/monsters/scorpion/sand-scuttler-ne-pincer[1~6].png:[100,120,100,80,100,100]"
            [/frame]
            [frame]
                image="units/monsters/scorpion/sand-scuttler-ne.png:1"
            [/frame]
            [if]
                hits="yes"
                [attack_sound_frame]
                    sound="pincers.ogg"
                [/attack_sound_frame]
            [/if]
            [else]
                hits="no"
                [attack_sound_frame]
                    sound="miss-[1~3].ogg"
                [/attack_sound_frame]
            [/else]
        [/attack_anim]
        [attack_anim]
            start_time="-620"
            offset="0.0:320,0.0~0.8:240,0.8~0.0:320"
            attack_sound_start_time="-100"
            [filter_attack]
                name="sting"
            [/filter_attack]
            [frame]
                image="units/monsters/scorpion/sand-scuttler-stinger-[1~7,6,5,4,1].png:[80,100,120,80*8]"
            [/frame]
            [frame]
                image="units/monsters/scorpion/sand-scuttler.png:1"
            [/frame]
            [if]
                hits="yes"
                [attack_sound_frame]
                    sound="spear.ogg"
                [/attack_sound_frame]
            [/if]
            [else]
                hits="no"
                [attack_sound_frame]
                    sound="miss-[1~3].ogg"
                [/attack_sound_frame]
            [/else]
        [/attack_anim]
        [event]
            id="unit_deprecation_message_scuttler"
            name="unit placed"
            [filter]
                type="Giant Scorpion"
                variation="scuttler"
            [/filter]
            [deprecated_message]
                what="Giant Scorpion scuttler variation"
                level="3"
                message="This variation has been moved to a separate unit, use unit type Sand Scuttler instead."
                version="1.19"
            [/deprecated_message]
        [/event]
    [/variation]
[/unit_type]

