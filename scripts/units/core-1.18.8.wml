    movement_type="elusivefoot"
    gender="male,female"
    [movement_costs]
        shallow_water="2"
        reef="2"
        swamp_water="2"
        flat="1"
        sand="2"
        forest="2"
        hills="2"
        mountains="3"
        village="1"
        castle="1"
        cave="2"
        frozen="2"
        fungus="2"
        grassland="1"
        water="2"
        keep="1"
    [/movement_costs]
    [defense]
        shallow_water="40"
        reef="50"
        swamp_water="40"
        flat="60"
        sand="40"
        forest="70"
        hills="70"
        mountains="70"
        village="70"
        castle="70"
        cave="50"
        frozen="40"
        fungus="70"
        grassland="60"
        water="40"
        keep="70"
    [/defense]
    [resistance]
        blade="-30"
        pierce="-20"
        impact="-20"
        fire="0"
        cold="0"
        arcane="10"
    [/resistance]
    [ability]
        id="skirmisher"
        name="skirmisher"
        female_name="female^skirmisher"
        description="This unit is skilled in moving past enemies quickly, and ignores all enemy Zones of Control."
        special_note="This unit’s skill at skirmishing allows it to ignore enemies’ zones of control and thus move unhindered around them."
        affect_self="yes"
        source_id="skirmisher"
        kind="skirmisher"
    [/ability]
    [attack]
        id="dagger"
        name="dagger"
        range="melee"
        damage_type="blade"
        damage="6"
        strikes="3"
        [special]
            id="backstab"
            name="backstab"
            description="When used offensively, this attack deals double damage if there is an enemy of the target on the opposite side of the target, and that unit is not incapacitated (turned to stone or otherwise paralyzed)."
            special_note="If there is an enemy of the target on the opposite side of the target while attacking it, this unit may backstab, inflicting double damage by creeping around behind that enemy."
            multiply="2"
            active_on="offense"
            source_id="backstab"
            kind="damage"
            [filter_opponent]
                formula=<<

                enemy_of(self, flanker) and not flanker.petrified
            where
                flanker = unit_at(direction_from(loc, other.facing))
            
>>
            [/filter_opponent]
        [/special]
    [/attack]
    [attack]
        id="throwing knives"
        name="throwing knives"
        range="ranged"
        damage_type="blade"
        damage="4"
        strikes="3"
    [/attack]
    [female]
        name="female^Rogue"
        gender="female"
        image="units/human-outlaws/rogue+female.png"
        profile="portraits/humans/thief+female.webp"
        die_sound="human-female-die-[1~3].ogg"
        [defend]
            start_time="-126"
            [frame]
                image="units/human-outlaws/rogue+female-defend-2.png:1,units/human-outlaws/rogue+female-defend-1.png:250,units/human-outlaws/rogue+female-defend-2.png:1"
            [/frame]
            [if]
                hit_sound_start_time="-25"
                hits="hit"
                [hit_sound_frame]
                    sound="human-female-hit-[1~3].ogg"
                [/hit_sound_frame]
            [/if]
        [/defend]
        [attack_anim]
            [filter_attack]
                name="throwing knives"
            [/filter_attack]
            [frame]
                image="units/human-outlaws/rogue+female.png:250"
            [/frame]
        [/attack_anim]
        [attack_anim]
            [filter_attack]
                name="dagger"
            [/filter_attack]
            [frame]
                image="units/human-outlaws/rogue+female.png:50"
            [/frame]
            [frame]
                image="units/human-outlaws/rogue+female.png:250"
            [/frame]
            [frame]
                image="units/human-outlaws/rogue+female.png:100"
            [/frame]
        [/attack_anim]
    [/female]
[/unit_type]

