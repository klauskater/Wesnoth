    [defense]
        shallow_water="20"
        reef="30"
        swamp_water="20"
        flat="40"
        sand="30"
        forest="50"
        hills="50"
        mountains="60"
        village="60"
        castle="60"
        cave="40"
        frozen="20"
        fungus="50"
