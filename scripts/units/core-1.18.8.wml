    [trait]
        id="fearless"
        availability="musthave"
        male_name="fearless"
        female_name="female^fearless"
        description="Fights normally during unfavorable times of day/night"
        help_text="Aversion to light and dark holds no sway over these brave individuals."
        [effect]
            apply_to="fearless"
        [/effect]
    [/trait]
    [attack]
        id="touch"
        name="touch"
        range="melee"
        damage_type="impact"
        damage="6"
        strikes="2"
        [special]
            id="plague"
            name="plague"
            description="When a unit is killed by a Plague attack, that unit is replaced with a Walking Corpse on the same side as the unit with the Plague attack. This doesn’t work on Undead or units in villages."
            special_note="Foes who lose their life to the plague will rise again in unlife, unless they are standing on a village."
            type="Walking Corpse"
            source_id="plague"
