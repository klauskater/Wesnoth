        pierce="0"
        impact="0"
        fire="10"
        cold="0"
        arcane="10"
    [/resistance]
    [attack]
        id="staff"
        name="staff"
        range="melee"
        damage_type="impact"
        damage="6"
        strikes="2"
    [/attack]
    [attack]
        id="fireball"
        name="fireball"
        range="ranged"
        damage_type="fire"
        damage="8"
        strikes="4"
        [special]
            id="magical"
            name="magical"
            description="This attack always has a 70% chance to hit regardless of the defensive ability of the unit being attacked."
            special_note="This unit has magical attacks, which always have a high chance of hitting an opponent."
            value="70"
            cumulative="no"
            source_id="magical"
            kind="chance_to_hit"
        [/special]
    [/attack]
    [female]
        name="female^Red Mage"
        gender="female"
        image="units/human-magi/red-mage+female.png"
        die_sound="human-female-die-[1~3].ogg"
        small_profile="portraits/humans/mage-red+female.webp~FL()"
        profile="portraits/humans/mage-red+female.webp"
        [defend]
            start_time="-126"
            [frame]
                image="units/human-magi/red-mage+female.png:1,units/human-magi/red-mage+female-defend.png:250,units/human-magi/red-mage+female.png:1"
            [/frame]
            [if]
                hit_sound_start_time="-25"
                hits="hit"
                [hit_sound_frame]
                    sound="human-female-hit-[1~3].ogg"
                [/hit_sound_frame]
            [/if]
        [/defend]
        [idle_anim]
            start_time="0"
            [filter]
                [not]
                    status="poisoned"
                [/not]
            [/filter]
            [filter]
                [filter_adjacent]
                    is_enemy="yes"
                    count="0"
                [/filter_adjacent]
            [/filter]
            [filter]
                formula="if(self.hitpoints > self.max_hitpoints / 3, 1, 0)"
            [/filter]
            [frame]
                image="units/human-magi/red-mage+female.png:150"
            [/frame]
        [/idle_anim]
        [attack_anim]
            missile_start_time="-350"
            [filter_attack]
                name="fireball"
            [/filter_attack]
            [if]
                hits="yes"
                [missile_frame]
                    image="projectiles/fireball-n-1.png~SCALE(60,60)~O(60%):40,projectiles/fireball-n-2.png~SCALE(80,80)~O(80%):100,projectiles/fireball-[n,n-2,n-1].png:[125,55,30]"
                    image_diagonal="projectiles/fireball-nw-1.png~SCALE(60,60)~O(60%):40,projectiles/fireball-nw-2.png~SCALE(80,80)~O(80%):100,projectiles/fireball-[nw,nw-2,nw-1].png:[125,55,30]"
                    offset="0.0~0.1,0.1~0.9"
                    directional_x="11~0"
                    y="-20~0"
                [/missile_frame]
                [missile_frame]
                    halo="projectiles/fireball-impact-[1~16].png:60"
                    offset="1.0"
                    auto_vflip="no"
                [/missile_frame]
            [/if]
            [else]
                hits="no"
                missile_offset="0.0~0.20,0.20~0.35,0.35~0.40,0.4~0.45"
                [missile_frame]
                    halo="projectiles/fireball-fail-[1~7].png:100"
                    halo_x="11~0"
                    halo_y="-20~0"
                    auto_vflip="no"
                [/missile_frame]
            [/else]
            [frame]
                image="units/human-magi/red-mage+female.png:50"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female-attack-magic-1.png:100"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female-attack-magic-[2,1].png:[150,75]"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female.png:75"
            [/frame]
        [/attack_anim]
        [attack_anim]
            [filter_attack]
                name="staff"
            [/filter_attack]
            [frame]
                image="units/human-magi/red-mage+female.png:50"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female-attack-staff-[1~2].png:[100,200]"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female-attack-magic-1.png:75"
            [/frame]
            [frame]
                image="units/human-magi/red-mage+female.png:75"
            [/frame]
        [/attack_anim]
    [/female]
[/unit_type]

