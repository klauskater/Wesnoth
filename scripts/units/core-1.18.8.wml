        range="melee"
        damage_type="arcane"
        damage="8"
        strikes="4"
        [special]
            id="drain"
            name="drains"
            description="This unit drains health from living units, healing itself for half the amount of damage it deals (rounded down)."
            special_note="During battle, this unit can drain life from victims to renew its own health."
            source_id="drains"
            kind="drains"
        [/special]
    [/attack]
