        female_name="female^skirmisher"
        description="This unit is skilled in moving past enemies quickly, and ignores all enemy Zones of Control."
        special_note="This unit’s skill at skirmishing allows it to ignore enemies’ zones of control and thus move unhindered around them."
        affect_self="yes"
        source_id="skirmisher"
        kind="skirmisher"
    [/ability]
    [attack]
        id="dagger"
        name="dagger"
        range="melee"
        damage_type="blade"
        damage="8"
        strikes="3"
        [special]
            id="backstab"
            name="backstab"
            description="When used offensively, this attack deals double damage if there is an enemy of the target on the opposite side of the target, and that unit is not incapacitated (turned to stone or otherwise paralyzed)."
            special_note="If there is an enemy of the target on the opposite side of the target while attacking it, this unit may backstab, inflicting double damage by creeping around behind that enemy."
            multiply="2"
            active_on="offense"
            source_id="backstab"
            kind="damage"
            [filter_opponent]
                formula=<<

                enemy_of(self, flanker) and not flanker.petrified
            where
                flanker = unit_at(direction_from(loc, other.facing))
            
>>
            [/filter_opponent]
        [/special]
    [/attack]
    [attack]
        id="throwing knives"
        name="throwing knives"
        range="ranged"
        damage_type="blade"
        damage="5"
        strikes="3"
        [special]
            id="poison"
            name="poison"
            description="This attack poisons living targets. Poisoned units lose 8 HP every turn until they are cured or are reduced to 1 HP. Poison cannot, of itself, kill a unit."
            special_note="The victims of this unit’s poison will continually take damage until they can be cured in town or by a unit which cures."
            source_id="poison"
            kind="poison"
        [/special]
    [/attack]
    [advancement]
