    [defense]
        shallow_water="20"
        reef="30"
        swamp_water="20"
        flat="40"
        sand="30"
        forest="50"
        hills="50"
        mountains="60"
        village="60"
        castle="60"
        cave="40"
        frozen="20"
        fungus="50"
        grassland="40"
        water="20"
        keep="60"
    [/defense]
    [resistance]
        blade="0"
        pierce="0"
        impact="0"
        fire="50"
        cold="50"
        arcane="10"
    [/resistance]
    [ability]
        id="teleport"
        name="teleport"
        female_name="female^teleport"
        description="This unit may teleport between any two empty villages owned by its side using one of its moves."
        special_note="This unit can use one move to teleport between any two empty villages controlled by its side."
        source_id="teleport"
        kind="teleport"
        [tunnel]
            id="village_teleport"
            [source]
                terrain="*^V*"
                formula=<<

                    owner_side = teleport_unit.side_number and (unit = teleport_unit or not unit)
                where
                    unit = unit_at(loc)
                
>>
            [/source]
            [target]
                terrain="*^V*"
                formula="owner_side = teleport_unit.side_number and not unit_at(loc)"
            [/target]
            [filter]
                ability="teleport"
            [/filter]
        [/tunnel]
    [/ability]
    [attack]
        id="staff"
        name="staff"
        range="melee"
        damage_type="impact"
        damage="7"
        strikes="2"
    [/attack]
    [attack]
        id="missile"
        name="missile"
        range="ranged"
        damage_type="fire"
        damage="9"
        strikes="4"
        [special]
            id="magical"
            name="magical"
            description="This attack always has a 70% chance to hit regardless of the defensive ability of the unit being attacked."
            special_note="This unit has magical attacks, which always have a high chance of hitting an opponent."
            value="70"
            cumulative="no"
            source_id="magical"
            kind="chance_to_hit"
        [/special]
    [/attack]
    [advancement]
        strict_amla="yes"
        max_times="100"
        id="amla_default"
        description="Max HP bonus +3, Max XP +20%"
        image="icons/amla-default.png"
        [effect]
            apply_to="hitpoints"
            increase_total="3"
            heal_full="yes"
        [/effect]
        [effect]
            apply_to="max_experience"
            increase="20%"
        [/effect]
        [effect]
            apply_to="status"
            remove="poisoned"
        [/effect]
        [effect]
            apply_to="status"
            remove="slowed"
        [/effect]
    [/advancement]
    [female]
        name="female^Silver Mage"
        gender="female"
        image="units/human-magi/silver-mage+female.png"
        profile="portraits/humans/mage-silver+female.webp"
        die_sound="human-female-die-[1~3].ogg"
        [defend]
            start_time="-126"
            [frame]
                image="units/human-magi/silver-mage+female.png:1,units/human-magi/silver-mage+female-defend.png:250,units/human-magi/silver-mage+female.png:1"
            [/frame]
            [if]
                hit_sound_start_time="-25"
                hits="hit"
                [hit_sound_frame]
                    sound="human-female-hit-[1~3].ogg"
                [/hit_sound_frame]
            [/if]
        [/defend]
        [attack_anim]
            offset="0"
            magic_missile_start_time="-750"
            magic_missile_trail_1_start_time="-350"
            magic_missile_trail_2_start_time="-350"
            magic_missile_trail_3_start_time="-350"
            magic_missile_flare_start_time="-750"
            [filter_attack]
                name="missile"
            [/filter_attack]
            [magic_missile_frame]
                duration="400"
                halo="halo/mage-halo[1~5].png"
                halo_x="14~0"
                halo_y="-23~-54"
                offset="0.001~-0.083,-0.083~-0.25,-0.25~-0.5"
            [/magic_missile_frame]
            [magic_missile_frame]
                duration="350"
                halo="halo/mage-halo[1~5].png"
                halo_y="-54~-45,-45~-27,-27~0"
                offset="-0.5~-0.25,-0.25~0.25,0.25~1.0"
            [/magic_missile_frame]
            [magic_missile_trail_1_frame]
                duration="350"
                halo="misc/blank-hex.png:40,halo/mage-preparation-halo[1~7].png"
                halo_y="-54:40,-54~-45,-45~-27,-27~0"
                offset="0.001:40,-0.5~-0.25,-0.25~0.25,0.25~1.0"
            [/magic_missile_trail_1_frame]
            [magic_missile_trail_2_frame]
