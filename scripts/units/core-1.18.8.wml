        image="units/dunefolk/burner/firetrooper+female.png"
        die_sound="human-female-die-[1~3].ogg"
        [defend]
            start_time="-126"
            [frame]
                image="units/dunefolk/burner/firetrooper+female.png:1,units/dunefolk/burner/firetrooper+female.png:250,units/dunefolk/burner/firetrooper+female.png:1"
            [/frame]
            [if]
                hit_sound_start_time="-25"
                hits="hit"
                [hit_sound_frame]
                    sound="human-female-hit-[1~3].ogg"
                [/hit_sound_frame]
            [/if]
        [/defend]
        [attack_anim]
            start_time="-200"
            attack_sound_start_time="-150"
            [filter_attack]
                name="dagger"
            [/filter_attack]
            [frame]
                image="units/dunefolk/burner/firetrooper+female.png:300"
            [/frame]
            [if]
                hits="yes"
                [attack_sound_frame]
                    sound="dagger-swish.wav"
                [/attack_sound_frame]
            [/if]
            [else]
                hits="no"
                [attack_sound_frame]
                    sound="dagger-swish.wav"
                [/attack_sound_frame]
            [/else]
        [/attack_anim]
        [attack_anim]
            start_time="-225"
            missile_start_time="-150"
            [filter_attack]
                name="flamethrower"
            [/filter_attack]
            [if]
                hits="yes"
                missile_start_time="0"
                [missile_frame]
                    duration="150"
                    image="projectiles/missile-fire-n.png"
                    image_diagonal="projectiles/missile-fire-ne.png"
                    offset="0~0.8"
                [/missile_frame]
                [missile_frame]
                    duration="600"
                    image="projectiles/fire-burst-small-[1~8].png"
                    image_diagonal="projectiles/fire-burst-small-[1~8].png"
                    offset="0.8~1.0"
                [/missile_frame]
                [frame]
                    image="units/dunefolk/burner/firetrooper+female.png:300"
                    sound="bow-puny-fire.ogg"
                [/frame]
            [/if]
            [else]
                hits="no"
                [missile_frame]
                    duration="150"
                    image="projectiles/missile-fire-n.png"
                    image_diagonal="projectiles/missile-fire-ne.png"
                [/missile_frame]
                [frame]
                    image="units/dunefolk/burner/firetrooper+female.png:300"
                    sound="bow-puny-fire-miss.ogg"
                [/frame]
            [/else]
        [/attack_anim]
    [/female]
[/unit_type]

