    [ability]
        id="ambush"
        name="ambush"
        female_name="female^ambush"
        description=<<
This unit can hide in forest, and remain undetected by its enemies.

Enemy units cannot see this unit while it is in forest, except if they have units next to it. Any enemy unit that first discovers this unit immediately loses all its remaining movement.
>>
        special_note="In woodlands, this unit’s ambush skill renders it invisible to enemies unless it is immediately adjacent or has revealed itself by attacking."
        affect_self="yes"
        source_id="ambush"
        kind="hides"
        [filter]
            [filter_location]
                terrain="*^F*,*^Qhhf,*^Qhuf"
            [/filter_location]
        [/filter]
    [/ability]
    [ability]
        value="8"
        id="regenerates"
        name="regenerates"
        female_name="female^regenerates"
        description="The unit will heal itself 8 HP per turn. If it is poisoned, it will remove the poison instead of healing."
        special_note="This unit regenerates, which allows it to heal as though always stationed in a village."
        affect_self="yes"
        poison="cured"
        source_id="regenerates"
        kind="regenerate"
    [/ability]
