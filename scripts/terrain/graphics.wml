# Компактные правила графики террейна для порта.
#
# Это намеренно не полный оригинальный terrain-graphics WML. Файл читает
# `src/terrain_rules.rs`, поэтому здесь поддерживаются только [terrain_rule],
# [constraint] и [image]. Макросы и стандартный препроцессор Wesnoth сюда
# напрямую переносить нельзя.
#
# Формат одного правила:
# - первый constraint без q/r проверяет гекс-якорь;
# - остальные constraint проверяют соседей в аксиальных смещениях q/r;
# - terrain — разрешённые коды, exclude — исключения (поддерживается `*`);
# - set_flags/forbid_flags не дают более поздним правилам повторно занять грань;
# - image.name — логическое имя, которое затем переводится в PNG в client.rs;
# - меньший layer рисуется раньше и лежит ниже.
#
# rotations=6 размножает правило на шесть направлений. @R0 превращается в
# n,ne,se,s,sw,nw; @R1 означает следующую сторону по часовой стрелке. Если
# используются нестандартные имена спрайтов, их задаёт rotation_names.

[terrain_rule]
    id=base-grass-green
    [constraint]
        terrain=Gg*
    [/constraint]
    [image]
        name=grass-green
        layer=-1000
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-n-s
    [constraint]
        terrain=*^Bw|*
    [/constraint]
    [image]
        name=wood-bridge-n-s
        layer=-10
    [/image]
[/terrain_rule]

# Это прежнее прямолинейное описание оставлено как справочник для формата
# компактных правил. Деревянные Bw-мосты из него больше не попадают в кадр:
# `wood_bridge_visuals` в terrain.rs сначала строит связи между соседними
# гексами (аналог TRACK_AWAY/TRACK_FINAL оригинала), а затем выбирает прямой
# или угловой PNG. Один символ `/`, `|` или `\` недостаточен для такого выбора.

[terrain_rule]
    id=bridge-wood-ne-sw
    [constraint]
        terrain=*^Bw/*
    [/constraint]
    [image]
        name=wood-bridge-ne-sw
        layer=-10
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-se-nw
    [constraint]
        terrain=*^Bw\*
    [/constraint]
    [image]
        name=wood-bridge-se-nw
        layer=-10
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-n-s
    [constraint]
        terrain=*^Bsb|*
    [/constraint]
    [image]
        name=stone-bridge-n-s
        layer=-10
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-ne-sw
    [constraint]
        terrain=*^Bsb/*
    [/constraint]
    [image]
        name=stone-bridge-ne-sw
        layer=-10
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-se-nw
    [constraint]
        terrain=*^Bsb\*
    [/constraint]
    [image]
        name=stone-bridge-se-nw
        layer=-10
    [/image]
[/terrain_rule]

# Окончания в воде используют оригинальные wood-dock-*. Эти правила обязаны
# идти раньше сухопутных рамп и выставляют bridge-end-направление. Иначе одно
# и то же место получит сразу два окончания.
[terrain_rule]
    id=bridge-wood-dock-n-s
    rotation_turns=0,3
    [constraint]
        terrain=*^Bw|*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=0
        r=-1
        terrain=W*,Ss*
        exclude=*^Bw|*
    [/constraint]
    [image]
        name=wood-bridge-dock-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-dock-ne-sw
    rotation_turns=0,3
    rotation_names=ne,se,s,sw,n,nw
    [constraint]
        terrain=*^Bw/*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=1
        r=-1
        terrain=W*,Ss*
        exclude=*^Bw/*
    [/constraint]
    [image]
        name=wood-bridge-dock-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-dock-se-nw
    rotation_turns=0,3
    rotation_names=se,s,sw,nw,n,ne
    [constraint]
        terrain=*^Bw\*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=1
        r=0
        terrain=W*,Ss*
        exclude=*^Bw\*
    [/constraint]
    [image]
        name=wood-bridge-dock-@R0
        layer=-9
    [/image]
[/terrain_rule]

# На границе с сушей используются wood-end-*. Одно компактное правило
# обрабатывает две противоположные стороны оси через rotation_turns=0,3.
[terrain_rule]
    id=bridge-wood-end-n-s
    rotation_turns=0,3
    [constraint]
        terrain=*^Bw|*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=0
        r=-1
        terrain=*
        exclude=W*,Ss*,*^Bw|*
    [/constraint]
    [image]
        name=wood-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-end-ne-sw
    rotation_turns=0,3
    rotation_names=ne,se,s,sw,n,nw
    [constraint]
        terrain=*^Bw/*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=1
        r=-1
        terrain=*
        exclude=W*,Ss*,*^Bw/*
    [/constraint]
    [image]
        name=wood-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-wood-end-se-nw
    rotation_turns=0,3
    rotation_names=se,s,sw,nw,n,ne
    [constraint]
        terrain=*^Bw\*
        forbid_flags=bridge-end-@R0
        set_flags=bridge-end-@R0
    [/constraint]
    [constraint]
        q=1
        r=0
        terrain=*
        exclude=W*,Ss*,*^Bw\*
    [/constraint]
    [image]
        name=wood-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-end-n-s
    rotation_turns=0,3
    [constraint]
        terrain=*^Bsb|*
    [/constraint]
    [constraint]
        q=0
        r=-1
        terrain=*
        exclude=*^Bsb|*
    [/constraint]
    [image]
        name=stone-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-end-ne-sw
    rotation_turns=0,3
    rotation_names=ne,se,s,sw,n,nw
    [constraint]
        terrain=*^Bsb/*
    [/constraint]
    [constraint]
        q=1
        r=-1
        terrain=*
        exclude=*^Bsb/*
    [/constraint]
    [image]
        name=stone-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=bridge-stone-end-se-nw
    rotation_turns=0,3
    rotation_names=se,s,sw,nw,n,ne
    [constraint]
        terrain=*^Bsb\*
    [/constraint]
    [constraint]
        q=1
        r=0
        terrain=*
        exclude=*^Bsb\*
    [/constraint]
    [image]
        name=stone-bridge-end-@R0
        layer=-9
    [/image]
[/terrain_rule]

[terrain_rule]
    id=base-shallow-water
    [constraint]
        terrain=Ww*,Wwf*,Wwg*
    [/constraint]
    [image]
        name=water
        layer=-1000
    [/image]
[/terrain_rule]

[terrain_rule]
    id=base-deep-water
    [constraint]
        terrain=Wo*
    [/constraint]
    [image]
        name=ocean
        layer=-1000
    [/image]
[/terrain_rule]

[terrain_rule]
    id=ocean-to-shallow
    rotations=6
    [constraint]
        terrain=Ww*,Wwf*,Wwg*
        forbid_flags=ocean-transition-@R0
        set_flags=ocean-transition-@R0
    [/constraint]
    [constraint]
        q=0
        r=-1
        terrain=Wo*
    [/constraint]
    [image]
        name=transition-ocean-@R0
        layer=-399
    [/image]
[/terrain_rule]
